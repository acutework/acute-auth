# Copy to .env and adjust. Everything has a development default: with no .env
# at all the service runs entirely in memory on the fake OTP provider.
JWT_SECRET=change-me-in-production

# fake | msg91
OTP_PROVIDER=fake

# Storage. Leave either blank to fall back to in-memory equivalents.
# Ports match docker-compose.yml, which is offset so it cannot collide with
# another Postgres or Redis already running on the usual ports.
DATABASE_URL=postgresql+asyncpg://acute_auth:acute_auth@localhost:5433/acute_auth
REDIS_URL=redis://localhost:6380/0

ACCESS_TOKEN_TTL_MINUTES=15
# A year, and it slides: every refresh issues a new one, so an active
# user never spends another SMS to stay signed in.
REFRESH_TOKEN_TTL_DAYS=365
REGISTRATION_TOKEN_TTL_MINUTES=10
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3

# Rate limits: <count> per <window> seconds.
OTP_SEND_LIMIT=5
OTP_SEND_WINDOW_SECONDS=3600
OTP_VERIFY_LIMIT=10
OTP_VERIFY_WINDOW_SECONDS=900

# Required only when OTP_PROVIDER=msg91. Both must be set or startup fails -
# a misconfigured provider should not wait until a user's first login.
MSG91_AUTHKEY=
MSG91_OTP_TEMPLATE_ID=

# Address lookup for saved places. Proxied through this service so the key is
# never shipped inside an app binary. Blank PLACES_PROVIDER disables search;
# users can still type an address by hand.
PLACES_PROVIDER=google
GOOGLE_PLACES_API_KEY=
PLACES_REGION_CODE=in
PLACES_LANGUAGE_CODE=en

# Circles. Invitations to a number with no account go out over MSG91's flow
# API; leave the template id blank and no SMS is attempted at all. An invite
# costs real money, so sends are capped per inviting user.
MSG91_INVITE_TEMPLATE_ID=
INVITE_SEND_LIMIT=20
INVITE_SEND_WINDOW_SECONDS=86400
APP_INVITE_BASE_URL=https://acutework.app/join
INVITE_LINK_TTL_SECONDS=604800
